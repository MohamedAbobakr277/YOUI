# Build limits
BUILD_MAX_ATTEMPTS_PER_DAY=3
BUILD_RETRY_WAIT_HOURS=24
EDIT_MAX_PER_DAY=10

# Validation
SPEC_VALIDATION_MAX_RETRIES=3
UNIQUENESS_THRESHOLD=50
