# LLM
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=4096

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=youi

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
